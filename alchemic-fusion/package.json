{
  "name": "alchemic-fusion",
  "version": "1.0.0",
  "description": "신비로운 연금술사의 실험실에서 펼쳐지는 원소들의 장대한 모험! 플레이어가 선택한 원소들이 서로 상호작용하며 예측 불가능한 드라마를 만드는 관전형 전략 파티 게임입니다.",
  "keywords": [
    "game",
    "alchemy",
    "physics",
    "simulation",
    "party-game",
    "korean"
  ],
  "author": "천재 기획자",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "preview": "npm run build && npm run start",
    "clean": "rm -rf .next out node_modules/.cache",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "framer-motion": "^11.14.4",
    "howler": "^2.2.4",
    "matter-js": "^0.20.0",
    "next": "15.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.1.14",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/matter-js": "^0.19.7",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/styled-components": "^5.1.34",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/alchemic-fusion.git"
  },
  "homepage": "https://alchemic-fusion.vercel.app",
  "bugs": {
    "url": "https://github.com/your-username/alchemic-fusion/issues"
  }
}
